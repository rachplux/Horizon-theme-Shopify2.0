{% liquid
  assign speaker = product.metafields.speaker
  assign shopify_ns = product.metafields.shopify
  assign model = product.metafields.system.model_number.value
  assign fields_list = 'Speaker Size,size|Sold Unit,sold_unit|Speakers,soundbar_speakers|Tweeters,soundbar_tweeters|Speaker Features,speaker_features|Voice Coil Size,vc_size|Power Output,power_output|RMS Power,rms_power|Peak Power,peak_power|Tweeter Diaphragm,tweeter_diaphragm|Tweeter Design,tweeter_design|Show Midrange Design,show_series_midrange|Frequency Response,fs|Sensitivity @ 1M/1W,sn|Impedance,impedance|LED lighting,integrated-led-lighting|IP Rating,ingress-protection-ip-rating,text|Speaker Design,speaker-design|Speaker Features,speaker-features|Auxiliary_input,auxiliary_input|Device Interface,device-interface|Connectivity Tech,connectivity-technology|Wire Length,wire_length|Mounting Depth,mounting_depth|Mounting Type,mounting_type|With Grills,grills|Package Contains,contains|Magnet Weight (lb.),magnet_weight' | split: '|'
%}

<div class='grid-container'>
  {% if model != blank %}
    <div class='spec-row'>
      <div class='spec-label'>Model</div>
      <div class='spec-value'>{{ model }}</div>
    </div>
  {% endif %}

  {% for field_item in fields_list %}
    {% liquid
      # 1. 基礎解析 - 拆分當下的這一筆 field_item
      assign parts = field_item | split: ','
      assign label = parts[0] | strip
      assign key = parts[1] | strip

      # 尋找資料源
      assign target = speaker[key] | default: shopify_ns[key]

      if target.value == blank
        continue
      endif

      # 2. 變數準備
      assign active_value = target.value
      assign meta_type = target.type
      assign unit = ''
      assign rendered_value = ''

      # 3. 單位判斷
      if key contains 'power'
        assign unit = ' Watts'
      elsif key contains 'sn'
        assign unit = ' dB'
      endif

      # 4. 核心渲染邏輯
      if meta_type contains 'list.metaobject'
        # 處理 Metaobject 列表
        assign items_array = '' | split: ''
        for obj in active_value
          assign val = obj.label.value | default: obj.name.value | default: obj.display_name
          assign val_as_arr = val | split: '||'
          assign items_array = items_array | concat: val_as_arr
        endfor
        assign rendered_value = items_array | join: ', '

      elsif meta_type == 'metaobject_reference'
        # 處理單一 Metaobject
        assign rendered_value = active_value.label.value | default: active_value.name.value | default: active_value.display_name

      elsif active_value.first != blank
        # 處理一般文字列表
        assign rendered_value = active_value | join: ' '
      else
        # 處理單一數值或字串
        assign rendered_value = active_value
      endif

      # 5. 封裝輸出
      capture rendered_output
        echo rendered_value | append: unit
      endcapture
    %}
    {% comment %}
      <div>
        <h5>{{ label }}</h5>
        <ul>
          <li>
            <span class='spec-label'>meta_type</span>
            | {{ meta_type }}
          </li>
          <li>
            <span class='spec-label'>items</span>
            | {{ items }}
          </li>

          <li>
            <span class='spec-label'>val</span>
            | {{ val }}
          </li>
          <li>
            <span class='spec-label'>val_as_arr</span>
            | {{ val_as_arr }}
          </li>
          <li>
            <span class='spec-label'>items_array</span>
            | {{ items_array }}
          </li>
          <li>
            <span class='spec-label'>active_value</span>
            | {{ active_value }}
          </li>

          <li>
            <span class='spec-label'>rendered_output</span>
            | {{ rendered_output }}
          </li>
        </ul>
      </div>
    {% endcomment %}

    <div class='spec-row'>
      <div class='spec-label'>{{ label }}</div>
      <div class='spec-value'>{{ rendered_output }}</div>
    </div>
  {% endfor %}
</div>
