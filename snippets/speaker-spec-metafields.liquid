{% liquid
  assign speaker = product.metafields.speaker
  assign tweeter_design = product.metafields.speaker.serie.value.tweeter_design.value
  assign model = product.metafields.system.model_number.value
  assign fields = 'Speaker Size,size|Speaker Type,type|Sold Unit,sold_unit|Speakers,soundbar_speakers|Tweeters,soundbar_tweeters|Speaker Features,speaker_features|Voice Coil Size,vc_size|Power Output,power_output|RMS Power,rms_power|Peak Power,peak_power|Tweeter Diaphragm,tweeter_diaphragm|Tweeter Design,tweeter_design|Show Midrange Design,show_series_midrange|Frequency Response,fs|Sensitivity @ 1M/1W,sn|Impedance,impedance|LED lighting,integrated-led-lighting|Auxiliary_input,auxiliary_input|Device Interface,device-interface|Connectivity Tech,connectivity-technology|Wire Length,wire_length|Mounting Depth,mounting_depth|Mounting Type,mounting_type|Package Contains,contains|Magnet Weight (lb.),magnet_weight
   %}

<div class='grid-container'>
  <div class='spec-row'>
    <div class='spec-label'>Model</div>
    <div>{{ model | default: 'N/A' }}</div>
  </div>

  {% for field in fields %}
    {% liquid
      assign label_key = field | split: ','
      assign label = label_key[0] | strip
      assign key = label_key[1] | strip
      assign value = speaker[key].value
    %}

    {% if value != blank %}
      {% if label contains 'Show Tweeter Design' and value == true %}
        <div class='spec-row'>
          <div class='spec-label'>Tweeter Design</div>
          <div>{{ tweeter_design }}</div>
        </div>
      {% else %}
        <div class='spec-row'>
          <div class='spec-label'>{{ label }}</div>
          <div>
            {% if label contains 'Power' %}
              {{ value }} Watts
            {% elsif label contains 'Sensitivity' %}
              {{ value }} dB
            {% elsif label contains 'Magnet Weight' %}
              {{ value }}
            {% else %}
              {% liquid
                assign rendered = value
                if value.first != blank
                  assign rendered = value | join: ' '
                endif
              %}
              {%- comment -%}
                上面的 if 在判斷是否是array
              {%- endcomment -%}
              {{ rendered }}
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endif %}
  {% endfor %}
</div>
