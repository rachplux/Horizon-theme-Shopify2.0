{% liquid
  assign amp = product.metafields.amplifier
  assign power = amp.power.value
  assign speaker = product.metafields.speaker
  assign system = product.metafields.system
  assign model = system.model_number.value
  assign classes = product.metafields.shopify['amplifier-class'].value
  assign channels = product.metafields.shopify['amplifier-configuration'].value
%}

<div class='grid-container'>
  {% assign fields = 'T.H.D,t_h_d,text|S/N,s_n,text|High Power Filter,high_pass_filter,text|Low Pass Filter,low_pass_filter,text|Subsonic Filter,subsonic,text|Bass Boost,bass_boost,text|Input,input,text|Output,output,text|Phase,phase,text'
    | split: '|'
  %}

  <div class='spec-row'>
    <div class='spec-label'>Model</div>
    <div>{{ model | default: '-' }}</div>
  </div>

  {% if classes != blank %}
    <div class='spec-row'>
      <div class='spec-label'>Amplifier Class</div>
      <div>
        {% for item in classes %}
          {%- if item.label -%}
            {{ item.label }}
          {%- else -%}
            {{ item }}
          {%- endif -%}
          {% unless forloop.last %}, {% endunless %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if channels != blank %}
    <div class='spec-row'>
      <div class='spec-label'>Channels</div>
      <div>
        {% for item in channels %}
          {%- if item.label -%}
            {{ item.label }}
          {%- else -%}
            {{ item }}
          {%- endif -%}
          {% unless forloop.last %}, {% endunless %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if power %}
    {% if power.rms_1_ohm.value != blank %}
      <div class='spec-row'>
        <div class='spec-label'>RMS 1 Ohm</div>
        <div>{{ power.rms_1_ohm.value }}</div>
      </div>
    {% endif %}
    {% if power.rms_2_ohm.value != blank %}
      <div class='spec-row'>
        <div class='spec-label'>RMS 2 Ohm</div>
        <div>{{ power.rms_2_ohm.value }}</div>
      </div>
    {% endif %}
    {% if power.rms_4_ohm.value != blank %}
      <div class='spec-row'>
        <div class='spec-label'>RMS 4 Ohm</div>
        <div>{{ power.rms_4_ohm.value }}</div>
      </div>
    {% endif %}
    {% if power.rms_bridge_4_ohm.value != blank %}
      <div class='spec-row'>
        <div class='spec-label'>RMS Bridge 4 Ohm</div>
        <div>{{ power.rms_bridge_4_ohm.value }}</div>
      </div>
    {% endif %}
    {% if power.max_power.value != blank %}
      <div class='spec-row'>
        <div class='spec-label'>Max Power</div>
        <div>{{ power.max_power.value }}</div>
      </div>
    {% endif %}
  {% endif %}

  {% if speaker.fs.value != blank %}
    <div class='spec-row'>
      <div class='spec-label'>Frequency Response</div>
      <div>{{ speaker.fs.value }}</div>
    </div>
  {% endif %}

  {% for field in fields %}
    {% liquid
      assign parts = field | split: ','
      assign label = parts[0]
      assign key = parts[1]
      assign type = parts[2]
    %}

    {% if amp[key].value != blank %}
      <div class='spec-row'>
        <div class='spec-label'>{{ label }}</div>
        <div>
          {% if type == 'boolean' %}
            {% if amp[key].value %}Yes{% else %}No{% endif %}
          {% else %}
            {{ amp[key].value }}
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endfor %}

  {% if system.remote_control.value %}
    <div class='spec-row'>
      <div class='spec-label'>Remote Control</div>
      <div>Yes</div>
    </div>
  {% endif %}
</div>
