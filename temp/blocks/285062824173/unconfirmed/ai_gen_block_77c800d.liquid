{% doc %}
  @prompt
    generate a check box, for applying for an international distributors, add the option into the feedback email
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-distributor-checkbox-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-distributor-checkbox__wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-distributor-checkbox__input-{{ ai_gen_id }} {
    width: {{ block.settings.checkbox_size }}px;
    height: {{ block.settings.checkbox_size }}px;
    min-width: {{ block.settings.checkbox_size }}px;
    cursor: pointer;
    accent-color: {{ block.settings.checkbox_color }};
    margin-top: 2px;
  }

  .ai-distributor-checkbox__label-{{ ai_gen_id }} {
    flex: 1;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    cursor: pointer;
    user-select: none;
  }

  .ai-distributor-checkbox__label-{{ ai_gen_id }} strong {
    font-weight: 600;
  }
{% endstyle %}

<div
  class="ai-distributor-checkbox-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-distributor-checkbox__wrapper-{{ ai_gen_id }}">
    <input
      type="checkbox"
      id="distributor-application-{{ ai_gen_id }}"
      name="contact[distributor_application]"
      value="Yes"
      class="ai-distributor-checkbox__input-{{ ai_gen_id }}"
    >
    <label
      for="distributor-application-{{ ai_gen_id }}"
      class="ai-distributor-checkbox__label-{{ ai_gen_id }}"
    >
      {% if block.settings.label_text != blank %}
        {{ block.settings.label_text }}
      {% else %}
        <strong>I am interested in becoming an international distributor</strong>
      {% endif %}
    </label>
  </div>
</div>

{% schema %}
{
  "name": "Distributor checkbox",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "label_text",
      "label": "Label text",
      "default": "<strong>I am interested in becoming an international distributor</strong>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "checkbox_size",
      "label": "Checkbox size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#dfdfdf"
    },
    {
      "type": "color",
      "id": "checkbox_color",
      "label": "Checkbox accent",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Distributor checkbox"
    }
  ]
}
{% endschema %}