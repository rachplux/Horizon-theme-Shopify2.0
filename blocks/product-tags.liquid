{% assign product = closest.product %}
{% assign meta = product.metafields %}
{% assign source = block.settings.choose_tag_source | default: 'product_tags' %}
{% assign fields = block.settings.metafield_input | split: '|' %}
{% assign tag_tag_size = block.settings.tag_size | default: 14 %}
{% assign tag_padding_block = tag_tag_size | times: 2.5 | divided_by: 14.0 %}
{% assign tag_padding_inline = tag_tag_size | times: 8.0 | divided_by: 14.0 %}
{% assign tag_alignment = block.settings.alignment | default: 'flex-start' %}


<div
  class="
  	product-tag-box 
	{% if block.settings.case == 'uppercase' %}
	 uppercase
	{% endif %}
	"
  style="--product-tag-font-size: {{ tag_tag_size }}px; --product-tag-padding-block: {{ tag_padding_block }}px; --product-tag-padding-inline: {{ tag_padding_inline }}px; --product-tag-alignment: {{ tag_alignment }};"
>
  {% if source == "product_tags" %}
    {% for tag in product.tags %}
      <div class="tag-item">{{ tag | strip }}</div>
    {% endfor %}
  {% endif %}

  {% if source == 'metafields' %}
    {% for field in fields %}
      {% assign field = field | strip %}
      {% assign parts = field | split: '.' %}
      {% assign namespace = parts[0] | strip %}
      {% assign key = parts[1] | strip %}
      {% assign metafield = meta[namespace][key] %}
      {% assign value = metafield.value %}

      {% if value != blank %}
        {% if value.first != blank %}
          {% for item in value %}
            <div class="tag-item">{{ item | strip }}</div>
          {% endfor %}
        {% else %}
          <div class="tag-item">{{ value | strip }}</div>
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
</div>


{% stylesheet %}
  .product-tag-box {
    display: inline-flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: var(--product-tag-alignment);
    width: 100%;

  }
  .tag-item {
    color: rgb(var(--color-foreground-rgb) / 0.7);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.5);
    font-size: var(--product-tag-font-size);
    padding: var(--product-tag-padding-block) var(--product-tag-padding-inline);
    margin-right: 10px;
  }
  .uppercase {
	text-transform: uppercase;
  }

{% endstylesheet %}
{% schema %}
  {
    "name": "Product Tags",
    "tag": null,
    "settings": [
		{
			"type": "header",
			"content": "t:content.typography"
		},
		{
        "type": "range",
        "id": "tag_size",
        "label": "Tag size",
        "min": 7,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 14
      },
	      {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
	    },
      {
        "type": "select",
        "id": "alignment",
        "label": "Alignment",
        "options": [
          {
            "value": "flex-start",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "flex-end",
            "label": "Right"
          }
        ],
        "default": "flex-start"
      },
      {
        "type": "header",
        "content": "t:content.content_layout"
      }, 
	 {
        "type": "select",
        "id": "choose_tag_source",
        "label": "Choose Tag Source",
        "options": [
          {
            "value": "product_tags",
            "label": "Product Tags"
          }, {
            "value": "metafields",
            "label": "Metafields Value"
          }
        ],
        "default": "product_tags"
      }, {
        "type": "textarea",
        "id": "metafield_input",

        "label": "Custom Metafield Input use {namespace}.{key}",
        "placeholder": "system.audio_type | speaker.size",
        "info": "Fill in metafields in format: {namespace}.{key} while divide with '|'. Check [Product Metafileds](https://admin.shopify.com/store/cadence-sound-demo/settings/custom_data/product/metafields) for namespaces & keys.",
        "visible_if": "{{ block.settings.choose_tag_source == 'metafields' }}"
      }
    ],
    "presets": [
      {
        "name": "Product Tags",
        "category": "t:categories.product"
      }
    ]
  }
{% endschema %}
