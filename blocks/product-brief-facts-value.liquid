{% liquid
  assign product_resource = closest.product | default: product
  assign source = block.settings.source
  assign speaker = product_resource.metafields.speaker
  assign amplifier = product_resource.metafields.amplifier
  assign amplifier_power = amplifier.power.value
  assign shopify = product_resource.metafields.shopify
  assign system = product_resource.metafields.system
  assign value_text = ''

  case source
    when 'speaker_power'
      if speaker.rms_power != blank
        capture value_text
          echo speaker.rms_power.value | append: 'W RMS'
          if speaker.peak_power != blank
            echo '<br>'
            echo speaker.peak_power.value | append: 'W Max'
          endif
        endcapture
      endif

    when 'speaker_size'
      if speaker.size != blank
        if speaker.size.value.first != blank
          assign value_text = speaker.size.value | join: ' & '
        else
          assign value_text = speaker.size.value
        endif
      endif

    when 'speaker_sold_unit'
      if speaker.sold_unit != blank
        assign value_text = speaker.sold_unit.value
      endif

    when 'amplifier_rms_lowest_ohm'
      assign rms_metafield = amplifier.rms_1_ohm | default: amplifier_power.rms_1_ohm
      assign rms_ohm = '1 Ohm'

      if rms_metafield == blank or rms_metafield.value == blank
        assign rms_metafield = amplifier.rms_2_ohm | default: amplifier_power.rms_2_ohm
        assign rms_ohm = '2 Ohm'
      endif

      if rms_metafield == blank or rms_metafield.value == blank
        assign rms_metafield = amplifier.rms_4_ohm | default: amplifier_power.rms_4_ohm
        assign rms_ohm = '4 Ohm'
      endif

      if rms_metafield != blank
        assign value_text = rms_metafield.value | default: rms_metafield
        assign value_text_downcase = value_text | downcase
        assign value_includes_ohm = false

        if value_text_downcase contains 'ohm'
          assign value_includes_ohm = true
        endif

        if value_text != blank and block.settings.show_amplifier_ohm and value_includes_ohm == false
          assign value_text = value_text | append: ' @ ' | append: rms_ohm
        endif
      endif

    when 'amplifier_class'
      assign target = amplifier['amplifier-class'] | default: amplifier_power['amplifier-class'] | default: shopify['amplifier-class'] | default: system['amplifier-class']

    when 'amplifier_channels'
      assign target = amplifier['amplifier-configuration'] | default: amplifier_power['amplifier-configuration'] | default: shopify['amplifier-configuration'] | default: system['amplifier-configuration']
  endcase

  if target != blank and value_text == blank
    assign active_value = target.value
    assign meta_type = target.type

    if meta_type contains 'list.metaobject'
      assign items_array = '' | split: ''
      for obj in active_value
        assign item_value = obj.label.value | default: obj.name.value | default: obj.display_name
        assign item_as_array = item_value | split: '||'
        assign items_array = items_array | concat: item_as_array
      endfor
      assign value_text = items_array | join: ' & '
    elsif meta_type == 'metaobject_reference'
      assign value_text = active_value.label.value | default: active_value.name.value | default: active_value.display_name
    elsif active_value.first != blank
      assign value_text = active_value | join: ' & '
    else
      assign value_text = active_value
    endif
  endif

  assign label_text = block.settings.label

  capture value_markup
    echo '<span class="product-brief-facts-value__text-inner">'
    echo value_text
    echo '</span>'
  endcapture
%}

{% if value_text != blank or request.design_mode %}
  <div
    class="product-brief-facts-value"
    style="
      --brief-facts-value-align: {{ block.settings.content_alignment }};
      --horizontal-alignment: {{ block.settings.content_alignment }};
      --text-align: {% if block.settings.content_alignment == 'flex-end' %}right{% elsif block.settings.content_alignment == 'center' %}center{% else %}left{% endif %};
      --brief-facts-value-text-align: {% if block.settings.content_alignment == 'flex-end' %}right{% elsif block.settings.content_alignment == 'center' %}center{% else %}left{% endif %};
      --brief-facts-value-gap: {{ block.settings.gap }}px;
      --brief-facts-label-font-family: {{ block.settings.label_font }};
      --brief-facts-label-font-size: {{ block.settings.label_font_size }};
      --brief-facts-label-color: {{ block.settings.label_color }};
      --brief-facts-label-text-transform: {{ block.settings.label_case }};
    "
  >
    {% if block.settings.show_label %}
      <div class="product-brief-facts-value__label">
        {{ label_text }}
      </div>
    {% endif %}

    {% render 'text', block: block, fallback_text: value_markup %}
  </div>
{% endif %}

{% stylesheet %}
  .product-brief-facts-value {
    align-self: var(--brief-facts-value-align-self, auto);
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: var(--brief-facts-value-align, center);
    gap: var(--brief-facts-value-gap, 12px);
    min-width: 0;
    width: 100%;
  }

  .product-brief-facts-value__label {
    color: var(--brief-facts-label-color);
    font-family: var(--brief-facts-label-font-family);
    font-size: var(--brief-facts-label-font-size);
    line-height: normal;
    margin: 0;
    text-align: var(--brief-facts-value-text-align, center);
    text-transform: var(--brief-facts-label-text-transform);
  }

  .product-brief-facts-value .text-block {
    align-items: var(--brief-facts-value-align, center);
    text-align: var(--brief-facts-value-text-align, center);
  }

  .product-brief-facts-value .text-block > .product-brief-facts-value__text-inner {
    display: block;
    inline-size: max-content;
    max-inline-size: 100%;
    text-align: var(--brief-facts-value-text-align, center);
  }
{% endstylesheet %}

