            "label": "t:options.custom"
          }
        ],
        "default": "fit-content"
      }, {
        "type": "range",
        "id": "custom_width",
        "label": "t:settings.custom_width",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 100,
