            "value": "h5",
            "label": "t:options.h5"
          },
          {
            "value": "h6",
            "label": "t:options.h6"
          }
        ],
        "default": "",
        "info": "t:info.edit_presets_in_theme_settings",
        "visible_if": "{{ block.settings.style_class == \"link\" }}"
      }, {
        "type": "checkbox",
        "id": "use_custom_link_text_color",
        "label": "Use custom link text color",
        "default": false,
        "visible_if": "{{ block.settings.style_class == \"link\" }}"
      }, {
        "type": "color",
        "id": "link_text_color",
        "label": "Link text color",
        "default": "#000000",
        "visible_if": "{{ block.settings.style_class == \"link\" and block.settings.use_custom_link_text_color == true }}"
      }, {
        "type": "checkbox",
        "id": "show_icon",
