{%- liquid
  assign facts_value_align_self = 'auto'
  if block.settings.align_facts_titles
    assign facts_value_align_self = 'stretch'
  endif

  capture facts_style
    echo '--brief-facts-value-align-self: '
    echo facts_value_align_self
    echo ';'
  endcapture
-%}

{%- capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'group',
  children: children,
  settings: block.settings,
  shopify_attributes: block.shopify_attributes,
  class: 'product-brief-facts',
  style: facts_style
%}
{% stylesheet %}
  .product-brief-facts :is(ul, ol)[class*='metafield'][class*='array'] {
    display: inline;
    list-style: none !important;
    margin: 0;
    padding: 0;
  }

  .product-brief-facts :is(ul, ol)[class*='metafield'][class*='array'] > li {
    display: inline;
    margin: 0;
    padding: 0;
  }

  .product-brief-facts :is(ul, ol)[class*='metafield'][class*='array'] > li + li::before {
    content: " & ";
  }

{% endstylesheet %}
