{% liquid
  assign serie = product.metafields.speaker.serie.value | default: product.metafields.amplifier.serie.value
  assign about_model = product.metafields.custom.about_model
  assign about_series = serie.short_description | default: serie.extra_features
%}

<section class="cadence-product-about">
  <div class="cadence-product-about__inner">
    <article class="cadence-product-about__column">
      <h2>{{ section.settings.model_heading }}</h2>
      <div class="cadence-product-about__text">
        {% if about_model != blank %}
          {{ about_model | metafield_tag }}
        {% elsif product.description != blank %}
          {{ product.description }}
        {% else %}
          {{ section.settings.model_fallback }}
        {% endif %}
      </div>
    </article>

    <article class="cadence-product-about__column">
      <h2>{{ section.settings.series_heading }}</h2>
      <div class="cadence-product-about__text">
        {% if about_series != blank %}
          {{ about_series | metafield_tag }}
        {% else %}
          {{ section.settings.series_fallback }}
        {% endif %}
      </div>
    </article>
  </div>
</section>

{% stylesheet %}
  .cadence-product-about {
    background: #030303;
    color: #f5f5f5;
    border-bottom: 1px solid rgb(255 255 255 / 14%);
  }

  .cadence-product-about__inner {
    width: min(980px, calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(34px, 8vw, 72px);
    padding: 18px 0 22px;
  }

  .cadence-product-about__column + .cadence-product-about__column {
    border-left: 1px solid rgb(255 255 255 / 22%);
    padding-left: clamp(28px, 5vw, 72px);
  }

  .cadence-product-about h2 {
    margin: 0 0 8px;
    color: #fff;
    font-size: clamp(1.65rem, 3vw, 2.45rem);
    line-height: 0.98;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .cadence-product-about__text {
    color: rgb(255 255 255 / 82%);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .cadence-product-about__text > *:first-child {
    margin-top: 0;
  }

  .cadence-product-about__text > *:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .cadence-product-about__inner {
      width: min(100% - 28px, 980px);
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .cadence-product-about__column + .cadence-product-about__column {
      border-left: 0;
      border-top: 1px solid rgb(255 255 255 / 18%);
      padding-left: 0;
      padding-top: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cadence Product About",
  "settings": [
    {
      "type": "text",
      "id": "model_heading",
      "label": "Model heading",
      "default": "About this model"
    },
    {
      "type": "richtext",
      "id": "model_fallback",
      "label": "Model fallback text"
    },
    {
      "type": "text",
      "id": "series_heading",
      "label": "Series heading",
      "default": "About the series"
    },
    {
      "type": "richtext",
      "id": "series_fallback",
      "label": "Series fallback text"
    }
  ],
  "presets": [
    {
      "name": "Cadence Product About"
    }
  ]
}
{% endschema %}
