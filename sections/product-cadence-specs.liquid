<section class="cadence-product-specs">
  <div class="cadence-product-specs__inner">
    <h2>{{ section.settings.heading }}</h2>
    <div class="cadence-product-specs__table-wrap">
      {% render 'cadence-speaker-spec-metafields' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .cadence-product-specs {
    background: #030303;
    color: #f5f5f5;
    border-bottom: 1px solid rgb(255 255 255 / 14%);
  }

  .cadence-product-specs__inner {
    width: min(980px, calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 28px;
    padding: 18px 0 22px;
  }

  .cadence-product-specs h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.65rem, 3vw, 2.45rem);
    line-height: 0.98;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .cadence-spec-table {
    width: 100%;
    border: 1px solid rgb(255 255 255 / 18%);
    background: #050505;
    font-size: 0.82rem;
    text-transform: uppercase;
  }

  .cadence-spec-table__row {
    display: grid;
    grid-template-columns: minmax(170px, 0.95fr) minmax(0, 1.35fr);
    min-height: 24px;
  }

  .cadence-spec-table__row:nth-child(odd) {
    background: rgb(255 255 255 / 10%);
  }

  .cadence-spec-table__label,
  .cadence-spec-table__value {
    padding: 4px 28px;
    border-right: 1px solid rgb(255 255 255 / 16%);
  }

  .cadence-spec-table__label {
    color: rgb(255 255 255 / 82%);
    font-weight: 700;
  }

  .cadence-spec-table__value {
    color: #fff;
  }

  @media screen and (max-width: 749px) {
    .cadence-product-specs__inner {
      width: min(100% - 28px, 980px);
      grid-template-columns: 1fr;
    }

    .cadence-spec-table__row {
      grid-template-columns: 1fr;
      padding: 8px 0;
    }

    .cadence-spec-table__label,
    .cadence-spec-table__value {
      padding: 2px 14px;
      border-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cadence Product Specs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Specifications"
    }
  ],
  "presets": [
    {
      "name": "Cadence Product Specs"
    }
  ]
}
{% endschema %}
