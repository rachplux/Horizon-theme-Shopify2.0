{% capture extra_details_content %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign extra_details_content = extra_details_content | strip
  assign has_content = false
  if extra_details_content != blank
    assign has_content = true
  endif
%}

{% if has_content or request.design_mode %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="
      product-extra-details
      product-extra-details--{{ section.settings.content_direction }}
      {% if section.settings.show_border and section.settings.border_top %}product-extra-details--border-top{% endif %}
      {% if section.settings.show_border and section.settings.border_bottom %}product-extra-details--border-bottom{% endif %}
      {% if section.settings.show_border and section.settings.border_left %}product-extra-details--border-left{% endif %}
      {% if section.settings.show_border and section.settings.border_right %}product-extra-details--border-right{% endif %}
      section
      section--{{ section.settings.section_width }}
      color-{{ section.settings.color_scheme }}
      spacing-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      --product-extra-details-columns: {{ section.settings.columns }};
      --product-extra-details-gap: {{ section.settings.gap }}px;
      --product-extra-details-border-width: {{ section.settings.border_width }}px;
    "
    {{ section.shopify_attributes }}
  >
    {% if has_content %}
      <div class="product-extra-details__grid">
        {{ extra_details_content }}
      </div>
    {% elsif request.design_mode %}
      <div class="product-extra-details__empty">
        Add blocks to build extra product details.
      </div>
    {% endif %}
  </section>
{% endif %}

{% stylesheet %}
  .product-extra-details {
    border-style: solid;
    border-color: rgb(var(--color-foreground-rgb) / 0.12);
    border-block-start-width: 0;
    border-block-end-width: 0;
    border-inline-start-width: 0;
    border-inline-end-width: 0;
  }

  .product-extra-details--border-top {
    border-block-start-width: var(--product-extra-details-border-width, 1px);
  }

  .product-extra-details--border-bottom {
    border-block-end-width: var(--product-extra-details-border-width, 1px);
  }

  .product-extra-details--border-left {
    border-inline-start-width: var(--product-extra-details-border-width, 1px);
  }

  .product-extra-details--border-right {
    border-inline-end-width: var(--product-extra-details-border-width, 1px);
  }

  .product-extra-details__grid {
    display: grid;
    gap: var(--product-extra-details-gap, 24px);
    align-items: start;
  }

  .product-extra-details--vertical .product-extra-details__grid {
    grid-template-columns: 1fr;
  }

  .product-extra-details--horizontal .product-extra-details__grid {
    grid-template-columns: repeat(var(--product-extra-details-columns, 1), minmax(0, 1fr));
  }

  .product-extra-details__empty {
    min-height: 120px;
    display: grid;
    place-items: center;
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.28);
    color: rgb(var(--color-foreground-rgb) / 0.62);
    font-size: 0.95rem;
  }

  @media screen and (max-width: 749px) {
    .product-extra-details__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product extra details",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "Direction",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.content_direction == 'horizontal' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Top border",
      "default": true,
      "visible_if": "{{ section.settings.show_border }}"
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Bottom border",
      "default": true,
      "visible_if": "{{ section.settings.show_border }}"
    },
    {
      "type": "checkbox",
      "id": "border_left",
      "label": "Left border",
      "default": false,
      "visible_if": "{{ section.settings.show_border }}"
    },
    {
      "type": "checkbox",
      "id": "border_right",
      "label": "Right border",
      "default": false,
      "visible_if": "{{ section.settings.show_border }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.show_border }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Product extra details"
    }
  ]
}
{% endschema %}
