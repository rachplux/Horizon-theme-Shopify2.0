{% liquid
  assign current_serie = product.metafields.speaker.serie.value | default: product.metafields.amplifier.serie.value
  assign current_serie_label = current_serie.label.value
  assign source_collection = section.settings.collection
  if source_collection == blank
    assign source_collection = product.collections.first
  endif
  assign rendered_count = 0
%}

<section class="cadence-series-products">
  <div class="cadence-series-products__inner">
    <h2>
      {{ section.settings.heading }}
      {% if current_serie_label != blank %}
        <span>{{ current_serie_label }}</span>
      {% endif %}
    </h2>

    <div class="cadence-series-products__grid">
      {% if source_collection != blank %}
        {% for card_product in source_collection.products limit: 24 %}
          {% liquid
            if card_product.id == product.id
              continue
            endif

            if section.settings.filter_same_series and current_serie_label != blank
              assign card_serie = card_product.metafields.speaker.serie.value | default: card_product.metafields.amplifier.serie.value
              assign card_serie_label = card_serie.label.value
              unless card_serie_label == current_serie_label
                continue
              endunless
            endif

            assign card_model = card_product.metafields.system.model_number.value | default: card_product.selected_or_first_available_variant.sku
            assign card_size = card_product.metafields.speaker.size.value
            assign card_type = card_product.metafields.speaker.type.value
            assign rendered_count = rendered_count | plus: 1
          %}

          <a class="cadence-series-products__card" href="{{ card_product.url }}">
            <div class="cadence-series-products__media">
              {% if card_product.featured_image != blank %}
                {{
                  card_product.featured_image
                  | image_url: width: 520
                  | image_tag:
                    widths: '260, 360, 520',
                    sizes: '(min-width: 990px) 30vw, 90vw',
                    loading: 'lazy',
                    class: 'cadence-series-products__image'
                }}
              {% endif %}
            </div>
            <div class="cadence-series-products__content">
              <h3>{{ card_model | default: card_product.title }}</h3>
              {% if card_size != blank or card_type != blank %}
                <p>
                  {% if card_size != blank %}
                    {{ card_size }}
                  {% endif %}
                  {% if card_size != blank and card_type != blank %}
                    <br>
                  {% endif %}
                  {% if card_type != blank %}
                    {{ card_type }}
                  {% endif %}
                </p>
              {% endif %}
              <span>{{ section.settings.card_link_label }}</span>
            </div>
          </a>

          {% if rendered_count >= section.settings.max_products %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    {% if rendered_count == 0 and request.design_mode %}
      <p class="cadence-series-products__empty">Choose a collection or add more products in the same series.</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cadence-series-products {
    background: #030303;
    color: #f5f5f5;
    border-bottom: 1px solid rgb(255 255 255 / 14%);
  }

  .cadence-series-products__inner {
    width: min(980px, calc(100% - 48px));
    margin: 0 auto;
    padding: 18px 0 14px;
  }

  .cadence-series-products h2 {
    margin: 0 0 12px;
    color: #fff;
    font-size: clamp(1.45rem, 2.6vw, 2.2rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .cadence-series-products h2 span {
    display: inline;
  }

  .cadence-series-products__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .cadence-series-products__card {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) minmax(110px, 0.9fr);
    gap: 12px;
    min-height: 126px;
    padding: 12px;
    border: 1px solid rgb(255 255 255 / 26%);
    background: linear-gradient(135deg, rgb(255 255 255 / 14%), rgb(255 255 255 / 4%));
    color: #fff;
    text-decoration: none;
  }

  .cadence-series-products__card:hover {
    border-color: #ff6a00;
  }

  .cadence-series-products__media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .cadence-series-products__image {
    width: 100%;
    height: 100%;
    max-height: 120px;
    object-fit: contain;
  }

  .cadence-series-products__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
  }

  .cadence-series-products h3 {
    margin: 0 0 6px;
    color: #fff;
    font-size: 1.55rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .cadence-series-products p {
    margin: 0 0 12px;
    color: rgb(255 255 255 / 86%);
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .cadence-series-products__content span {
    width: fit-content;
    color: #ff6a00;
    border-bottom: 1px solid #ff6a00;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .cadence-series-products__empty {
    color: rgb(255 255 255 / 70%);
  }

  @media screen and (max-width: 989px) {
    .cadence-series-products__grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .cadence-series-products__inner {
      width: min(100% - 28px, 980px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cadence Series Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More from the"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "filter_same_series",
      "label": "Only show products with the same series metafield",
      "default": true
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "card_link_label",
      "label": "Card link label",
      "default": "View model"
    }
  ],
  "presets": [
    {
      "name": "Cadence Series Products"
    }
  ]
}
{% endschema %}
